{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix projeto-atualizado install",
  "buildCommand": "npm --prefix projeto-atualizado run build",
  "outputDirectory": "projeto-atualizado/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
